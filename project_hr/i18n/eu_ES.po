#, python-format
msgid "You can't assign a category that is not allowed at project level."
msgstr "Ezin da proiektu-mailan baimenduta ez dagoen kategoriarik esleitu."

#. module: project_hr
#. odoo-python
#: code:addons/project_hr/models/project_task.py:0
